{
  "name": "@kannan19302/shared",
  "version": "1.0.6",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22 <23"
  },
  "description": "Shared types, validators, constants, and utilities",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./auth-client": {
      "types": "./dist/auth-client/index.d.ts",
      "import": "./dist/auth-client/index.js",
      "require": "./dist/auth-client/index.js",
      "default": "./dist/auth-client/index.js"
    },
    "./auth-client/react": {
      "types": "./dist/auth-client/react.d.ts",
      "import": "./dist/auth-client/react.js",
      "require": "./dist/auth-client/react.js",
      "default": "./dist/auth-client/react.js"
    },
    "./module-registry": {
      "types": "./dist/module-registry/index.d.ts",
      "import": "./dist/module-registry/index.js",
      "require": "./dist/module-registry/index.js",
      "default": "./dist/module-registry/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks/index.js",
      "require": "./dist/blocks/index.js",
      "default": "./dist/blocks/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kannan19302/contracts": "file:../unierp-contracts",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "jose": "^5.9.6",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@kannan19302/config": "^1.0.2",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "2.1.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
